# Copiez ce fichier en .env puis adaptez-le.

# Port et adresse d'écoute (127.0.0.1 = accessible uniquement depuis votre machine)
PORT=3000
HOST=127.0.0.1

# Mot de passe facultatif (authentification HTTP Basic, utilisateur libre).
# Indispensable si vous exposez le serveur sur le réseau (HOST=0.0.0.0).
# MULTILLM_PASSWORD=

# Clés API facultatives : dans l'interface, saisissez « env:NOM_VARIABLE » à la place
# de la clé pour qu'elle soit lue ici plutôt qu'enregistrée dans data/models.json.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
